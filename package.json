{
  "name": "cs2-companion",
  "version": "0.1.0",
  "description": "Local-first desktop companion app for Counter-Strike 2 — captures live GSI data, enriches it with demo parsing, and surfaces improvement-focused stats.",
  "author": "Mellidium",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "package:win": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir",
    "mock-gsi": "tsx scripts/mock-gsi-sender.ts",
    "gen-cfg": "tsx scripts/generate-gsi-config.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@laihoe/demoparser2": "^0.40.0",
    "better-sqlite3": "^12.11.1",
    "globaloffensive": "^3.1.4",
    "steam-user": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
